@page
@model sweetshops.Pages.Desserts.IndexModel
@{
    ViewData["Title"] = "Список блюд";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold text-primary">🍽️ Список блюд</h1>
        <a asp-page="Create" class="btn btn-success btn-lg">
            <i class="bi bi-plus-circle"></i> Добавить новое блюдо
        </a>
    </div>

    @if (!Model.Dishs.Any())
    {
        <div class="alert alert-info text-center p-5" role="alert">
            <h4 class="alert-heading">Нет блюд</h4>
            <p>В меню пока нет блюд. Нажмите кнопку "Добавить новое блюдо", чтобы создать первое блюдо.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var dish in Model.Dishs)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm hover-shadow transition">
                        <div class="card-header bg-white border-bottom-0 pt-3">
                            <span class="badge bg-secondary fs-6">@dish.GroupDish?.Name</span>
                        </div>

                        <div class="card-body">
                            <h5 class="card-title fw-bold text-dark">@dish.DishName</h5>

                            <div class="mb-3">
                                <span class="badge bg-success fs-6 me-2">
                                    💰 @dish.Price.ToString("C")
                                </span>
                                <span class="badge bg-info fs-6">
                                    ⏱️ @dish.CookingTimeMinutes мин
                                </span>
                            </div>

                            @if (!string.IsNullOrEmpty(dish.DescriptionDish))
                            {
                                <p class="card-text text-muted">
                                    <strong>Описание:</strong><br>
                                    @(dish.DescriptionDish.Length > 100
                                                            ? dish.DescriptionDish.Substring(0, 100) + "..."
                                                            : dish.DescriptionDish)
                    </p>
                                        }

                            @if (!string.IsNullOrEmpty(dish.Ingredients))
                            {
                                <p class="card-text small text-muted">
                                    <strong>🥕 Ингредиенты:</strong><br>
                                    @(dish.Ingredients.Length > 80
                                                            ? dish.Ingredients.Substring(0, 80) + "..."
                                                            : dish.Ingredients)
                    </p>
                                        }
                        </div>

                        <div class="card-footer bg-white border-top-0 pb-3">
                            <div class="d-flex justify-content-between gap-2">
                                <a asp-page="Details" asp-route-id="@dish.Id"
                                   class="btn btn-outline-primary btn-sm flex-fill">
                                    🔍 Открыть
                                </a>
                                <a asp-page="Edit" asp-route-id="@dish.Id"
                                   class="btn btn-outline-warning btn-sm flex-fill">
                                    ✏️ Изменить
                                </a>
                                <a asp-page="Delete" asp-route-id="@dish.Id"
                                   class="btn btn-outline-danger btn-sm flex-fill">
                                    🗑️ Удалить
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .hover-shadow {
        transition: all 0.3s ease;
    }

        .hover-shadow:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.15) !important;
        }

    .transition {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .card-header .badge {
        font-size: 0.9rem;
        padding: 6px 12px;
    }

    .card-body {
        min-height: 200px;
    }

    @@media (max-width: 768px) {
        .container {
            padding: 0 15px;
        }

        .btn-group .btn {
            font-size: 12px;
            padding: 6px 8px;
        }
    }
</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">