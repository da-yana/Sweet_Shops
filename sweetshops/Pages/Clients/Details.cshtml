@page
@model sweetshops.Pages.Clients.DetailsModel
@{
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <!-- Карточка деталей клиента -->
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white rounded-top-4 py-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-person-badge fs-3 me-2"></i>
                        <h5 class="mb-0 fw-bold">Информация о клиенте</h5>
                    </div>
                </div>

                <div class="card-body p-4">
                    <!-- Аватар и основная информация -->
                    <div class="text-center mb-4">
                        <div class="bg-light rounded-circle d-inline-flex p-3 mb-3">
                            <i class="bi bi-person-circle fs-1 text-primary"></i>
                        </div>
                        <h3 class="mb-1">@Model.Client.LastName</h3>
                        <span class="badge bg-success mt-2">
                            <i class="bi bi-check-circle"></i> Активный
                        </span>
                    </div>

                    <hr />

                    <!-- Детальная информация -->
                    <div class="row g-3">
                        <!-- Телефон -->
                        <div class="col-12">
                            <div class="d-flex align-items-center p-3 bg-light rounded-3">
                                <div class="me-3">
                                    <i class="bi bi-telephone-fill fs-4 text-primary"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Номер телефона</small>
                                    <strong class="fs-5">@Model.Client.Phone</strong>
                                </div>
                            </div>
                        </div>

                        <!-- Номер столика -->
                        <div class="col-md-6">
                            <div class="d-flex align-items-center p-3 bg-light rounded-3">
                                <div class="me-3">
                                    <i class="bi bi-table fs-4 text-success"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Номер столика</small>
                                    <strong class="fs-5">№@Model.Client.NumberOrder</strong>
                                </div>
                            </div>
                        </div>

                        <!-- Дата посещения -->
                        <div class="col-md-6">
                            <div class="d-flex align-items-center p-3 bg-light rounded-3">
                                <div class="me-3">
                                    <i class="bi bi-calendar-event fs-4 text-warning"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Дата посещения</small>
                                    <strong class="fs-5">@Model.Client.VisitDate.ToString("dd.MM.yyyy")</strong>
                                </div>
                            </div>
                        </div>

                        <!-- ID клиента -->
                        <div class="col-12">
                            <div class="d-flex align-items-center p-3 bg-light rounded-3">
                                <div class="me-3">
                                    <i class="bi bi-hash fs-4 text-secondary"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">ID клиента</small>
                                    <strong class="fs-5">#@Model.Client.Id</strong>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- Кнопки действий -->
                    <div class="d-flex gap-3 mt-4">
                        <a asp-page="Edit" asp-route-id="@Model.Client.Id" class="btn btn-warning btn-lg flex-grow-1">
                            <i class="bi bi-pencil-square"></i> Редактировать
                        </a>
                        <a asp-page="Index" class="btn btn-outline-secondary btn-lg flex-grow-1">
                            <i class="bi bi-arrow-left"></i> Назад к списку
                        </a>
                    </div>

                    <!-- Дополнительная информация -->
                    <div class="alert alert-info mt-4 rounded-3" role="alert">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        <strong>Информация:</strong> Для изменения данных клиента нажмите "Редактировать".
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    /* Кастомные стили */
    .card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.15) !important;
        }

    .btn {
        transition: all 0.2s ease;
    }

        .btn:hover {
            transform: translateY(-1px);
            filter: brightness(0.98);
        }

    .bg-light {
        transition: all 0.3s ease;
    }

        .bg-light:hover {
            background-color: #e9ecef !important;
            transform: translateX(5px);
        }
</style>