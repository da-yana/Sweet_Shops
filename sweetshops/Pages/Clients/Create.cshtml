@page
@model sweetshops.Pages.Clients.CreateModel
@{
}
<h1>Добавить клиента</h1>

<form method="post">
    <div>
        <label>Фамилия и имя</label><br />
        <input asp-for="Clients.LastName" />
    </div>

    <div>
        <label>Номер телефона</label><br />
        <input asp-for="Clients.Phone" />
    </div>

    <div>
        <label>Номер столика</label><br />
        <input asp-for="Clients.NumberOrder" />
    </div>

    <div>
        <label>Дата посещения</label><br />
        <input asp-for="Clients.VisitDate" type="date" />
    </div>

    <button type="submit">Сохранить</button>
</form>
