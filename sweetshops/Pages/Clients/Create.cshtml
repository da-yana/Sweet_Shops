@page
@model sweetshops.Pages.Clients.CreateModel
@{
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <!-- Карточка формы -->
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white rounded-top-4 py-3">
                    <h2 class="h4 mb-0">
                        <i class="bi bi-person-plus"></i> Добавить нового клиента
                    </h2>
                </div>

                <div class="card-body p-4">
                    <form method="post">
                        <!-- Фамилия и имя -->
                        <div class="mb-3">
                            <label asp-for="Clients.LastName" class="form-label fw-semibold">
                                👤 Фамилия и имя <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Clients.LastName"
                                   class="form-control form-control-lg"
                                   placeholder="Введите фамилию и имя клиента" />
                            <span asp-validation-for="Clients.LastName" class="text-danger small"></span>
                            <small class="text-muted">Например: Иванов Иван</small>
                        </div>

                        <!-- Номер телефона -->
                        <div class="mb-3">
                            <label asp-for="Clients.Phone" class="form-label fw-semibold">
                                📱 Номер телефона <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">+7</span>
                                <input asp-for="Clients.Phone"
                                       class="form-control form-control-lg"
                                       placeholder="(999) 123-45-67" />
                            </div>
                            <span asp-validation-for="Clients.Phone" class="text-danger small"></span>
                            <small class="text-muted">Введите номер телефона для связи</small>
                        </div>

                        <div class="row">
                            <!-- Номер столика -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Clients.NumberOrder" class="form-label fw-semibold">
                                    🪑 Номер столика <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Clients.NumberOrder"
                                       type="number"
                                       class="form-control form-control-lg"
                                       placeholder="1"
                                       min="1" />
                                <span asp-validation-for="Clients.NumberOrder" class="text-danger small"></span>
                                <small class="text-muted">От 1 до 50</small>
                            </div>

                            <!-- Дата посещения -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Clients.VisitDate" class="form-label fw-semibold">
                                    📅 Дата посещения <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Clients.VisitDate"
                                       type="date"
                                       class="form-control form-control-lg" />
                                <span asp-validation-for="Clients.VisitDate" class="text-danger small"></span>
                                <small class="text-muted">Выберите дату визита</small>
                            </div>
                        </div>

                        <!-- Кнопки действий -->
                        <div class="d-flex gap-3 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg flex-grow-1">
                                <i class="bi bi-check-circle"></i> Добавить клиента
                            </button>
                            <a asp-page="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-arrow-left"></i> Отмена
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Информационный блок -->
            <div class="alert alert-info mt-4 rounded-3" role="alert">
                <i class="bi bi-info-circle-fill"></i>
                <strong>Информация:</strong>
                <ul class="mb-0 mt-2">
                    <li>Поля с <span class="text-danger">*</span> обязательны для заполнения</li>
                    <li>Номер столика можно изменить при бронировании</li>
                    <li>Дата посещения не может быть в прошлом</li>
                    <li>После добавления клиент появится в общем списке</li>
                </ul>
            </div>

            <!-- Дополнительный совет -->
            <div class="card mt-3 border-0 bg-light rounded-3">
                <div class="card-body py-3">
                    <i class="bi bi-emoji-smile"></i>
                    <strong>Совет:</strong> Если клиент постоянный, вы можете добавить его в программу лояльности позже.
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Подключение скриптов для валидации -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    /* Кастомные стили */
    .form-control:focus {
        border-color: #86b7fe;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }

    .card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        }

    .btn {
        transition: all 0.2s ease;
    }

        .btn:hover {
            transform: translateY(-1px);
            filter: brightness(0.98);
        }

    /* Стили для валидации */
    .input-validation-error {
        border-color: #dc3545;
        background-color: #fff8f8;
    }

    .field-validation-error {
        display: block;
        margin-top: 0.25rem;
        font-size: 0.875rem;
        color: #dc3545;
    }
    /* Кастомный скролл */
    ::-webkit-scrollbar {
        width: 8px;
    }

    ::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 10px;
    }

    ::-webkit-scrollbar-thumb {
        background: #888;
        border-radius: 10px;
    }

        ::-webkit-scrollbar-thumb:hover {
            background: #555;
        }
</style>