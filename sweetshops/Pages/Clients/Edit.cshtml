@page
@model sweetshops.Pages.Clients.EditModel

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card shadow-sm mt-4">
                <div class="card-header bg-warning">
                    <h5 class="mb-0">Редактирование клиента</h5>
                </div>

                <div class="card-body">

                    <form method="post">
                        <input type="hidden" asp-for="Client.Id" />

                        <div class="mb-3">
                            <label asp-for="Client.LastName" class="form-label"></label>
                        <input asp-for="Client.LastName" class="form-control" />
                        <span asp-validation-for="Client.LastName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Client.Phone" class="form-label"></label>
                        <input asp-for="Client.Phone" class="form-control" />
                        <span asp-validation-for="Client.Phone" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                        <label asp-for="Client.NumberOrder" class="form-label"></label>
                        <input asp-for="Client.NumberOrder" class="form-control" />
                        <span asp-validation-for="Client.NumberOrder" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Client.VisitDate" class="form-label"></label>
                            <input asp-for="Client.VisitDate" type="date" class="form-control" />
                            <span asp-validation-for="Client.VisitDate" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-page="Index" class="btn btn-outline-secondary">
                                Назад
                            </a>

                            <button type="submit" class="btn btn-success">
                                Сохранить
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }

