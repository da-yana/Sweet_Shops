@page
@model sweetshops.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "Профиль";
}

<h1>Профиль пользователя</h1>

<div>
    <h4>Информация о пользователе</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Email
        </dt>
        <dd class="col-sm-10">
            @Model.CurrentUser?.Email
        </dd>
        <dt class="col-sm-2">
            Роль
        </dt>
        <dd class="col-sm-10">
            @Model.CurrentUser?.Role
        </dd>
    </dl>
</div>
<a asp-page="/Index" class="btn btn-primary">На главную</a>